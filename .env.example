BOT_TOKEN=replace_me

DATABASE_URL=postgresql+asyncpg://englsh:englsh@postgres:5432/englsh
REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO
# json = structured one-line-per-event logs (production); console = pretty (local dev)
LOG_FORMAT=json
DEFAULT_DAILY_GOAL=10
TXT_MAX_BYTES=524288
TXT_MAX_LINES=5000
IMPORT_MAX_WORDS=1000

INTERACTION_TTL_SECONDS=900
STUDY_TTL_SECONDS=3600

RATE_LIMIT_PER_SECOND=5

# Pre-shared password required to use the bot. Leave empty to disable the gate.
# Set to any non-empty string in your private .env to lock the bot down.
ACCESS_PASSWORD=

# Feature flag for the Japanese track. Off until JA flow is implemented end-to-end.
ENABLE_JAPANESE=false
